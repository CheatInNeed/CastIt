{
  "name": "castit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run build && node scripts/install-companion.mjs",
    "uninstall-companion": "node scripts/install-companion.mjs --uninstall",
    "dev:extension": "npm run dev -w @castit/extension",
    "dev:testpage": "vite tests/manual --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run build -w @castit/extension && npm run build -w @castit/companion",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/extension && tsc --noEmit -p apps/companion",
    "compat": "node tests/compat/report.ts",
    "compat:site": "node tests/compat/movy-sim/run.ts",
    "icons": "node apps/extension/scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^25.9.9",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
